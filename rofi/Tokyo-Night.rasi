/************************************************
 * ROFI Color theme
 * User: leofa
 * Colors: Tokyo Night
 * Copyright: 2017 leofa
 ***********************************************/

* {
    selected-normal-foreground:  rgba ( 26, 27, 38, 100 % );
    foreground:                  rgba ( 192, 202, 245, 100 % );
    normal-foreground:           @foreground;
    alternate-normal-background: rgba ( 36, 40, 59, 70 % );
    red:                         rgba ( 247, 118, 142, 100 % );
    selected-urgent-foreground:  rgba ( 26, 27, 38, 100 % );
    blue:                        rgba ( 122, 162, 247, 100 % );
    urgent-foreground:           rgba ( 247, 118, 142, 100 % );
    alternate-urgent-background: rgba ( 65, 72, 104, 90 % );
    active-foreground:           rgba ( 187, 154, 247, 100 % );
    lightbg:                     rgba ( 192, 202, 245, 100 % );
    selected-active-foreground:  rgba ( 26, 27, 38, 100 % );
    alternate-active-background: rgba ( 65, 72, 104, 89 % );
    background:                  rgba ( 26, 27, 38, 95 % );
    alternate-normal-foreground: @foreground;
    normal-background:           @background;
    lightfg:                     rgba ( 86, 95, 137, 100 % );
    selected-normal-background:  rgba ( 122, 162, 247, 100 % );
    border-color:                rgba ( 65, 72, 104, 100 % );
    spacing:                     2;
    separatorcolor:              rgba ( 22, 22, 30, 100 % );
    urgent-background:           rgba ( 22, 22, 30, 17 % );
    selected-urgent-background:  rgba ( 247, 118, 142, 100 % );
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba ( 0, 0, 0, 0 % );
    alternate-active-foreground: @active-foreground;
    active-background:           rgba ( 22, 22, 30, 17 % );
    selected-active-background:  rgba ( 122, 162, 247, 100 % );
}

window {
    width:            900px;
    transparency:     "real";
    location:         "center";
    anchor:           "center";
    background-color: @background;
    border:           1px;
    padding:          5px;
    border-radius:    6px;
}
mainbox {
    enabled: true;
    spacing: 10px;
    margin:  0px;
    padding: 20px;
    border-radius: 10px;
    border:  0px;
    padding: 0px;
}
message {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    padding:      1px ;
}
textbox {
    text-color: @foreground;
    background-color: @active-background;
    padding: 20px;
}
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       15;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     5px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px;
    border-radius:               6px;
    cursor:                      "default";
}
element {
    border:  0;
    padding: 8px 12px;
    border-radius: 10px;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
}
element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}
element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}
element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}
element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}
element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}
element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}
element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}
element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}
scrollbar {
    width:        4px ;
    border:       0;
    handle-color: @normal-foreground;
    handle-width: 8px ;
    padding:      0;
}
mode-switcher {
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
}
button {
    spacing:    0;
    text-color: @normal-foreground;
}
button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
inputbar {
    spacing:    0;
    text-color: @active-background;
    background-color: @alternate-normal-background;
    border-radius: 10px;
    radius: 10px;
    padding:    10px ;
}
case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}
entry {
    spacing:    0;
    text-color: @normal-foreground;
}
prompt {
    spacing:    0;
    text-color: @normal-foreground;
}
inputbar {
    children:   [ textbox-prompt-colon,entry,case-indicator ];
}
textbox-prompt-colon {
    expand:     false;
    str:        "󰍉 ";
    margin:     0px 0px 0px 0px ;
    text-color: @blue;
}
configuration {
    show-icons: true;
    font: "JetBrainsMono Nerd Font 13";
}
